# SEBM Backend Environment Variables Template
# Copy this file to .env and adjust values for local development.
# Never commit real credentials or .env to version control.

# Server Configuration
PORT=4000
NODE_ENV=development

# Security & TLS Configuration
# Set TLS_ENABLED=true to terminate TLS directly in Node.js
TLS_ENABLED=false
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem
# TLS_MIN_VERSION=TLSv1.2

# Reverse Proxy & HTTPS Enforcement
# Configure TRUST_PROXY when behind a trusted reverse proxy (e.g. 1, "loopback", "10.0.0.0/8")
# Unrestricted TRUST_PROXY=true is rejected in production
TRUST_PROXY=false
# Set ENFORCE_HTTPS=true to reject unencrypted external requests
ENFORCE_HTTPS=false
# Set HSTS_INCLUDE_SUBDOMAINS=true only when all subdomains support HTTPS
HSTS_INCLUDE_SUBDOMAINS=false

# JWT Configuration
# Set a strong local secret. Never commit real credentials or .env files.
JWT_SECRET=

# PostgreSQL Database Configuration
# Default development values align with docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sebm
DB_USER=sebm
DB_PASSWORD=sebm_dev_password
DB_SSL=false

# Connection Pool Settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=2000

# Optional Database Connection String (overrides individual DB_* fields if provided)
# DATABASE_URL=postgresql://sebm:sebm_dev_password@localhost:5432/sebm
